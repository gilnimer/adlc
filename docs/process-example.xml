<process name="Feature-Development" type="workflow">
    <!-- Triggered manually via CLI or Copilot Chat -->
    <trigger type="manual" />

    <globals>
        <var name="ticket_id" required="true" />
        <var name="context_files" required="false" />
    </globals>

    <steps>
        <!-- STEP 1: Principal plans the architecture -->
        <step id="plan" agent="principal" prompt=".github/prompts/plan.prompt.md">
            <input format="text">Draft architecture for ticket: ${{ticket_id}}. Reference:
                ${{context_files}}</input>
            <output save_as="blueprint" />
            <routing>
                <on-status value="success" goto="develop" />
                <on-error goto="escalate" retry_count="2" />
            </routing>
        </step>

        <!-- STEP 2: Developer writes the code (Target for QA feedback loop) -->
        <step id="develop" agent="developer" prompt=".github/prompts/developer.prompt.md">
            <input format="text">Implement this blueprint: ${{blueprint}}</input>
            <output save_as="source_code" />
            <routing>
                <on-status value="success" goto="qa-review" />
            </routing>
        </step>

        <!-- STEP 3: QA reviews the code against the original blueprint -->
        <step id="qa-review" agent="qa" prompt=".github/prompts/qa.prompt.md">
            <input format="text">Review this code against the blueprint. Code: ${{source_code}}
                Blueprint: ${{blueprint}}</input>
            <output save_as="qa_report" />
            <routing>
                <!-- Standard success path -->
                <on-status value="approve" goto="finish" />

                <!-- Feedback Loop: Kick back to developer, pass the QA report, retry up to 3 times -->
                <on-status value="reject" goto="develop" pass_feedback="true" retry_count="3" />

                <!-- Circuit Breaker: If they fail 3 times, bring in a human/manager -->
                <on-max-retries goto="escalate" />
            </routing>
        </step>

        <!-- STEP 4: Terminal States (These would map to system tools/skills) -->
        <step id="finish" agent="system" prompt="create-pr">
            <input format="text">Title: Implement ${{ticket_id}}</input>
        </step>

        <step id="escalate" agent="system" prompt="notify-human">
            <input format="text">Agents stuck in a loop on ${{ticket_id}}. QA Report: ${{qa_report}}</input>
        </step>
    </steps>
</process>